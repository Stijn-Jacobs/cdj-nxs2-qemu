+/*
+ * CDJ_GUI_IDLE_PC: the display board's idle task, executed as a halt.
+ *
+ * The SH7269 board's RTOS idle task is a counter loop (mov.l @r1,r2 /
+ * add #1,r2 / bra / mov.l r2,@r1) that takes most of that QEMU's CPU time.
+ * Its only exit is an interrupt that switches to a ready task, which is
+ * exactly what SLEEP waits for, so the loop can be run as one.
+ *
+ * It refuses to halt while an interrupt is already pending: on this board a
+ * request the CPU cannot accept yet (SR.IMASK, SR.BL) stays set, and halting on
+ * it would trade a cheap four-instruction loop for an exception per iteration.
+ * The guest then runs its counter loop as before.
+ */
+void helper_cdj_gui_idle(CPUSH4State *env)
+{
+    CPUState *cs = env_cpu(env);
+
+    if (cs->interrupt_request & CPU_INTERRUPT_HARD) {
+        return;
+    }
+    cs->halted = 1;
+    env->in_sleep = 1;
+    raise_exception(env, EXCP_HLT, 0);
+}
