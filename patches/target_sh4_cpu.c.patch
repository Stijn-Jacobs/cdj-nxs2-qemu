diff --git a/target/sh4/cpu.c b/target/sh4/cpu.c
index 8f07261..7fd6476 100644
--- a/target/sh4/cpu.c
+++ b/target/sh4/cpu.c
@@ -72,14 +72,18 @@ static bool superh_io_recompile_replay_branch(CPUState *cs,
