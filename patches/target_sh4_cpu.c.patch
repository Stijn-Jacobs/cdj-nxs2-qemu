+/*
+ * Generic SH-2A for SH-2A-only guests (CDJ-850 MAIN): enables the 32-bit
+ * translator path via SH_FEATURE_SH2A. The PVR/PRR/CVR are placeholders;
+ * Task 5 (board bring-up) should set the real chip's IDs once known. They
+ * are not consulted on the translate/helper paths.
+ */
+static void sh2a_cpu_initfn(Object *obj)
+{
+    CPUSH4State *env = cpu_env(CPU(obj));
+
+    env->id = SH_CPU_SH2A;
+    env->features = SH_FEATURE_SH2A;
+}
+
+static void sh2a_class_init(ObjectClass *oc, void *data)
+{
+    SuperHCPUClass *scc = SUPERH_CPU_CLASS(oc);
+
+    scc->pvr = 0x00000000;
+    scc->prr = 0x00000000;
+    scc->cvr = 0x00000000;
+}
