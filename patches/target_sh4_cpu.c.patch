 #ifndef CONFIG_USER_ONLY
+static int get_tlb(QEMUFile *f, void *pv, size_t size,
+                   const VMStateField *field)
+{
+    tlb_t *t = pv;
+    uint32_t bits;
+
+    t->vpn = qemu_get_be32(f);
+    t->ppn = qemu_get_be32(f);
+    t->size = qemu_get_be32(f);
+    t->asid = qemu_get_byte(f);
+    bits = qemu_get_be32(f);
+    t->v = bits;
+    t->sz = bits >> 1;
+    t->sh = bits >> 3;
+    t->c = bits >> 4;
+    t->pr = bits >> 5;
+    t->d = bits >> 7;
+    t->wt = bits >> 8;
+    t->sa = bits >> 9;
+    t->tc = bits >> 12;
+    return 0;
+}
+
+static int put_tlb(QEMUFile *f, void *pv, size_t size,
+                   const VMStateField *field, JSONWriter *vmdesc)
+{
+    tlb_t *t = pv;
+
+    qemu_put_be32(f, t->vpn);
+    qemu_put_be32(f, t->ppn);
+    qemu_put_be32(f, t->size);
+    qemu_put_byte(f, t->asid);
+    qemu_put_be32(f, t->v | t->sz << 1 | t->sh << 3 | t->c << 4 |
+                  t->pr << 5 | t->d << 7 | t->wt << 8 | t->sa << 9 |
+                  t->tc << 12);
+    return 0;
+}
+
+static const VMStateInfo vmstate_info_tlb = {
+    .name = "sh4_tlb",
+    .get = get_tlb,
+    .put = put_tlb,
+};
+
+static int sh_cpu_post_load(void *opaque, int version_id)
+{
+    CPUSH4State *env = &SUPERH_CPU(opaque)->env;
+
+    /* fp_status is derived from FPSCR, the same way LDS FPSCR sets it. */
+    set_float_rounding_mode((env->fpscr & FPSCR_RM_MASK) == FPSCR_RM_ZERO ?
+                            float_round_to_zero : float_round_nearest_even,
+                            &env->fp_status);
+    set_flush_to_zero((env->fpscr & FPSCR_DN) != 0, &env->fp_status);
+    return 0;
+}
+
