+/*
+ * CDJ_USB_TRACE for a directory-backed medium.
+ *
+ * With MEDIA_MODE=rw the "stick" is a host directory served by this driver: there
+ * is no image, so an LBA on its own says nothing. open_file() is where the driver
+ * decides which host file to read from, and mapping->path is the real path, so
+ * the log names the file instead of guessing from cluster numbers. Same variable
+ * as the SCSI-level trace in hw/scsi/scsi-disk.c.
+ */
+static void cdj_usb_trace_open(const char *path)
+{
+    static FILE *out;
+    static bool ready, on;
+    static unsigned long lines, limit = 200000;
+    const char *e, *l;
+
+    if (!ready) {
+        e = getenv("CDJ_USB_TRACE");
+        l = getenv("CDJ_USB_TRACE_LIMIT");
+        on = e && *e && strcmp(e, "0") != 0;
+        if (on && l && *l) {
+            limit = strtoul(l, NULL, 10);
+        }
+        if (on) {
+            out = (strchr(e, '/') || strchr(e, '\\')) ? fopen(e, "a") : stderr;
+            if (!out) {
+                out = stderr;
+            }
+        }
+        ready = true;
+    }
+    if (!on || lines >= limit || !path) {
+        return;
+    }
+    lines++;
+    fprintf(out, "cdj-usb open file=%s\n", path);
+    fflush(out);
+}
