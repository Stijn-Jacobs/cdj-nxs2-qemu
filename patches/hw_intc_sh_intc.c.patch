+/*
+ * Priority of whichever source owns this vector, or -1 if unknown. The CPU
+ * needs it because SH-4 loads the accepted interrupt's priority into SR.IMASK
+ * on delivery.
+ */
+int sh_intc_vector_priority(struct intc_desc *desc, int vect)
+{
+    unsigned int i;
+
+    if (!desc) {
+        return -1;
+    }
+
+    for (i = 0; i < desc->nr_sources; i++) {
+        if (desc->sources[i].vect == vect) {
+            return sh_intc_source_priority(desc, i);
+        }
+    }
+    return -1;
 }
 
