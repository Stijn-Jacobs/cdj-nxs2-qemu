+/*
+ * Is `id` reachable from the group source `head` by following the member chain
+ * sh_intc_register_sources() builds? Bounded by the source count because a
+ * malformed table could otherwise close the chain into a cycle.
+ */
+static bool sh_intc_group_contains(struct intc_desc *desc, intc_enum head,
+                                   intc_enum id)
+{
+    intc_enum cur = desc->sources[head].next_enum_id;
+    int steps;
+
+    /* A group's members are chained through next_enum_id as well, so the
+     * rest of a member's chain is its siblings, not its members. */
+    if (desc->sources[head].vect) {
+        return false;
+    }
+    for (steps = 0; cur && steps < desc->nr_sources; steps++) {
+        if (cur == id) {
+            return true;
+        }
+        cur = desc->sources[cur].next_enum_id;
+    }
+    return false;
+}
+
+/*
+ * Current priority of a source, read out of whichever IPR field carries it, or
+ * -1 if no priority register covers this source. Field order matches
+ * sh_intc_locate(): enum_ids[0] is the most significant field of the register.
+ *
+ * A source may hold its IPR field indirectly. Where several vectors share one
+ * priority field the board declares a group, the group's enum id is what
+ * appears in the prio_reg, and the individual sources appear nowhere in it --
+ * so a direct search reports "no priority" for a source that plainly has one
+ * (the four DMAC DEIs sharing IPRE[15:12], for instance), and the CPU cannot
+ * raise SR.IMASK to it on acceptance. Fall back to the owning group before
+ * giving up.
+ */
+static int sh_intc_source_priority(struct intc_desc *desc, intc_enum id)
+{
+    unsigned int i, k;
+
+    if (!desc->prio_regs) {
+        return -1;
+    }
+
+    for (i = 0; i < desc->nr_prio_regs; i++) {
+        struct intc_prio_reg *pr = &desc->prio_regs[i];
+        unsigned int width = pr->field_width;
+        unsigned int first = pr->reg_width / width - 1;
+
+        for (k = 0; k <= first; k++) {
+            intc_enum owner = pr->enum_ids[k];
+
+            if (owner == id ||
+                (owner && sh_intc_group_contains(desc, owner, id))) {
+                return (pr->value >> ((first - k) * width)) &
+                       ((1u << width) - 1);
+            }
+        }
+    }
+    return -1;
+}
