+/*
+ * CDJ_JCPROF=1: why does the jump cache miss?
+ *
+ * MAIN's vCPU spends a large share of its time in helper_lookup_tb_ptr and the
+ * qht. The helper itself is unavoidable on SH-4 (every call is jsr @Rn and
+ * every return is rts), but the qht part is paid only when the per-CPU jump
+ * cache misses, and a profile cannot say why it misses. This counts, per lookup site (translated code vs the cpu loop) and
+ * per TB-exit kind (CDJ_EXIT_*, stored by translate.c), how many lookups hit
+ * and how the misses split: empty slot (cold or flushed), slot holding another
+ * pc (conflict: the cache is too small / badly hashed), or the same pc under
+ * other flags (PR/SZ/FR, SR.RB/MD, PENDING_MOVCA variants thrashing one slot).
+ * It also prints the TLB flush counts, since every TLB flush clears the whole
+ * jump cache. Read-only: it never changes what tb_lookup() returns.
+ */
+#if defined(TARGET_SH4) && !defined(CONFIG_USER_ONLY)
+#define CDJ_JCPROF_SITES 2      /* 0 = cpu loop, 1 = helper_lookup_tb_ptr */
+enum { CDJ_JC_HIT, CDJ_JC_EMPTY, CDJ_JC_CONFLICT, CDJ_JC_FLAGS, CDJ_JC_NOUT };
+
+static int cdj_jcprof = -1;
+static uint64_t cdj_jc_count[CDJ_JCPROF_SITES][CDJ_EXIT_NKINDS][CDJ_JC_NOUT];
+static uint64_t cdj_jc_total;
+
+static bool cdj_jcprof_on(void)
+{
+    if (unlikely(cdj_jcprof < 0)) {
+        const char *e = getenv("CDJ_JCPROF");
+
+        cdj_jcprof = e && *e && strcmp(e, "0") != 0;
+    }
+    return cdj_jcprof;
+}
+
+static void cdj_jcprof_print(CPUState *cpu)
+{
+    static const char *const kname[CDJ_EXIT_NKINDS] = {
+        "unknown", "rts", "call", "jmp", "xpage", "now", "fpscr", "stop",
+        "predmiss",
+    };
+    CPUSH4State *env = cpu_env(cpu);
+    int s, k;
+
+    fprintf(stderr, "[CDJ] jcprof total=%" PRIu64 " jcbits=%d tlbflush "
+            "full=%zu part=%zu elided=%zu tbflush=%u fpscr lds=%" PRIu64
+            " flagchg=%" PRIu64 "\n", cdj_jc_total, TB_JMP_CACHE_BITS,
+            cpu->neg.tlb.c.full_flush_count, cpu->neg.tlb.c.part_flush_count,
+            cpu->neg.tlb.c.elide_flush_count,
+            qatomic_read(&tb_ctx.tb_flush_count), env->cdj_fpscr_lds,
+            env->cdj_fpscr_lds_flagchg);
+    for (s = 0; s < CDJ_JCPROF_SITES; s++) {
+        for (k = 0; k < CDJ_EXIT_NKINDS; k++) {
+            uint64_t *c = cdj_jc_count[s][k];
+
+            if (c[CDJ_JC_HIT] | c[CDJ_JC_EMPTY] | c[CDJ_JC_CONFLICT]
+                | c[CDJ_JC_FLAGS]) {
+                fprintf(stderr, "[CDJ] jcprof %s %-8s hit=%" PRIu64
+                        " empty=%" PRIu64 " conflict=%" PRIu64
+                        " flags=%" PRIu64 "\n", s ? "helper" : "loop  ",
+                        kname[k], c[CDJ_JC_HIT], c[CDJ_JC_EMPTY],
+                        c[CDJ_JC_CONFLICT], c[CDJ_JC_FLAGS]);
+            }
+        }
+    }
+}
+
+/* Classify the jump-cache probe tb_lookup() is about to make. */
+static void cdj_jcprof_note(CPUState *cpu, int site, vaddr pc,
+                            uint64_t cs_base, uint32_t flags, uint32_t cflags)
+{
+    CPUSH4State *env = cpu_env(cpu);
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    uint32_t hash = tb_jmp_cache_hash_func(pc);
+    TranslationBlock *tb = qatomic_read(&jc->array[hash].tb);
+    unsigned kind = env->cdj_exit_kind;
+    int out;
+
+    env->cdj_exit_kind = CDJ_EXIT_UNKNOWN;
+    if (kind >= CDJ_EXIT_NKINDS) {
+        kind = CDJ_EXIT_UNKNOWN;
+    }
+    if (!tb) {
+        out = CDJ_JC_EMPTY;
+    } else if (jc->array[hash].pc != pc) {
+        out = CDJ_JC_CONFLICT;
+    } else if (tb->cs_base != cs_base || tb->flags != flags
+               || tb_cflags(tb) != cflags) {
+        out = CDJ_JC_FLAGS;
+    } else {
+        out = CDJ_JC_HIT;
+    }
+    cdj_jc_count[site][kind][out]++;
+    if ((++cdj_jc_total & ((1u << 26) - 1)) == 0) {
+        cdj_jcprof_print(cpu);
+    }
+}
+
+#define CDJ_JCPROF_NOTE(cpu, site, pc, cs_base, flags, cflags)          \
+    do {                                                                \
+        if (unlikely(cdj_jcprof_on())) {                                \
+            cdj_jcprof_note(cpu, site, pc, cs_base, flags, cflags);     \
+        }                                                               \
+    } while (0)
+#else
+#define CDJ_JCPROF_NOTE(cpu, site, pc, cs_base, flags, cflags) do { } while (0)
+#endif
