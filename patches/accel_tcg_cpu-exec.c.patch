-    sc->diff_clk = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - sc->realtime_clock;
+    sc->diff_clk = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - sc->realtime_clock
+                   + cdj_icount_forgiven;
+    cap = cdj_icount_maxlag_ns();
+    if (cap && sc->diff_clk < -cap) {
+        cdj_icount_forgiven += -cap - sc->diff_clk;
+        sc->diff_clk = -cap;
+    }
     sc->last_cpu_icount
         = cpu->icount_extra + cpu->neg.icount_decr.u16.low;
     if (sc->diff_clk < max_delay) {
@@ -213,6 +262,104 @@ static TranslationBlock *tb_htable_lookup(CPUState *cpu, TCGTBCPUState s)
