+/*
+ * CDJ_ICOUNT_MAXLAG_MS=<n>: never owe real time more than n ms.
+ *
+ * align=on only sleeps when the guest is ahead; when it is behind it runs flat
+ * out until the whole debt is repaid. After a slow stretch that repayment can
+ * last minutes at well above real time, which overruns the audio and gives a
+ * synced deck a clock it cannot lock to. With a cap, lateness beyond n ms is
+ * forgiven instead of raced back: a slow passage costs a small permanent slip
+ * and never a later overspeed burst. The debt is kept as an offset on the
+ * real-time reference; 0 or unset keeps QEMU's behaviour.
+ */
+static int64_t cdj_icount_forgiven;
+
+static int64_t cdj_icount_maxlag_ns(void)
+{
+    static int64_t cap = -1;
+
+    if (cap < 0) {
+        const char *e = getenv("CDJ_ICOUNT_MAXLAG_MS");
+
+        cap = e ? (int64_t)strtoll(e, NULL, 0) * SCALE_MS : 0;
+        if (cap < 0) {
+            cap = 0;
+        }
+    }
+    return cap;
+}
+
 static void init_delay_params(SyncClocks *sc, CPUState *cpu)
 {
