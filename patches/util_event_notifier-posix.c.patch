+#ifdef EMSCRIPTEN
+#include <emscripten/threading.h>
+
+/*
+ * A pipe write or read from a QEMU thread is proxied, synchronously, to the
+ * browser's main thread, so each set cost a round trip to a thread that may
+ * be busy drawing. Here the pipe only gives the notifier an fd for the poll
+ * set: the signal is a flag per read fd, and every set bumps
+ * event_notifier_seq, which qemu_poll_ns sleeps on.
+ */
+#define NOTIFIER_FDS 1024
+static bool notifier_fd[NOTIFIER_FDS];
+static int notifier_pending[NOTIFIER_FDS];
+uint32_t event_notifier_seq;
+
+/* -1 when fd is not a notifier's read end, else whether it is set. */
+int event_notifier_fd_pending(int fd)
+{
+    if (fd < 0 || fd >= NOTIFIER_FDS || !notifier_fd[fd]) {
+        return -1;
+    }
+    return qatomic_read(&notifier_pending[fd]);
+}
+#endif
+
