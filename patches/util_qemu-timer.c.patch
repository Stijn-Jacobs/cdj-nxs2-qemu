--- a/util/qemu-timer.c
+++ b/util/qemu-timer.c
@@ -31,6 +31,11 @@
 #include "system/replay.h"
 #include "system/cpus.h"
 #include "hw/core/cpu.h"
+#ifdef EMSCRIPTEN
+#include "qemu/event_notifier.h"
+#include <emscripten/threading.h>
