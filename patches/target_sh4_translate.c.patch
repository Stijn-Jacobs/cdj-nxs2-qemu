+        int32_t imm = (int32_t)((((uint32_t)op >> 4) & 0xf) << 16 | w2);
+
+        if (imm & 0x00080000) {
+            imm |= 0xfff00000;
+        }
+        if (op & 1) {
+            imm <<= 8;          /* MOVI20S */
+        }
+        tcg_gen_movi_i32(REG(n), imm);
+        return true;
+    }
+
+    m = B7_4;
+    sub = (w2 >> 12) & 0xf;
+    disp = w2 & 0x0fff;
+    addr = tcg_temp_new();
+
+    switch (sub) {
+    case 0x0:   /* MOV.B Rm,@(disp,Rn) */
+        tcg_gen_addi_i32(addr, REG(n), disp);
+        tcg_gen_qemu_st_i32(REG(m), addr, ctx->memidx, MO_UB);
+        cdj_gen_mwatch_after_store(ctx);
+        return true;
+    case 0x1:   /* MOV.W Rm,@(disp*2,Rn) */
+        tcg_gen_addi_i32(addr, REG(n), disp * 2);
+        tcg_gen_qemu_st_i32(REG(m), addr, ctx->memidx, MO_TEUW);
+        cdj_gen_mwatch_after_store(ctx);
+        return true;
+    case 0x2:   /* MOV.L Rm,@(disp*4,Rn) */
+        tcg_gen_addi_i32(addr, REG(n), disp * 4);
+        tcg_gen_qemu_st_i32(REG(m), addr, ctx->memidx, MO_TEUL);
+        cdj_gen_mwatch_after_store(ctx);
+        return true;
+    case 0x4:   /* MOV.B @(disp,Rm),Rn */
+        tcg_gen_addi_i32(addr, REG(m), disp);
+        cdj_gen_rwatch_ea(ctx, addr);
+        tcg_gen_qemu_ld_i32(REG(n), addr, ctx->memidx, MO_SB);
+        return true;
+    case 0x5:   /* MOV.W @(disp*2,Rm),Rn */
+        tcg_gen_addi_i32(addr, REG(m), disp * 2);
+        cdj_gen_rwatch_ea(ctx, addr);
+        tcg_gen_qemu_ld_i32(REG(n), addr, ctx->memidx, MO_TESW);
+        return true;
+    case 0x6:   /* MOV.L @(disp*4,Rm),Rn */
+        tcg_gen_addi_i32(addr, REG(m), disp * 4);
+        cdj_gen_rwatch_ea(ctx, addr);
+        tcg_gen_qemu_ld_i32(REG(n), addr, ctx->memidx, MO_TESL);
+        return true;
+    case 0x8:   /* MOVU.B @(disp,Rm),Rn -- zero-extending */
+        tcg_gen_addi_i32(addr, REG(m), disp);
+        cdj_gen_rwatch_ea(ctx, addr);
+        tcg_gen_qemu_ld_i32(REG(n), addr, ctx->memidx, MO_UB);
+        return true;
+    case 0x9:   /* MOVU.W @(disp*2,Rm),Rn -- zero-extending */
+        tcg_gen_addi_i32(addr, REG(m), disp * 2);
+        cdj_gen_rwatch_ea(ctx, addr);
+        tcg_gen_qemu_ld_i32(REG(n), addr, ctx->memidx, MO_TEUW);
+        return true;
+    default:
+        /*
+         * The BAND.B / BOR.B / BXOR.B / BLD.B bit-manipulation group shares
+         * this slot and is not implemented. Logged, because a missing load
+         * treated as a silent nop leaves a stale register that fails far
+         * away. Still a nop: aborting the translation block would be worse.
+         */
+        qemu_log_mask(LOG_UNIMP,
+                      "sh2a: unimplemented 0x3nm1 sub-opcode 0x%x at "
+                      "pc=0x%08x -- treated as nop\n",
+                      sub, (uint32_t)ctx->base.pc_next);
+        return true;
+    }
+}
+
+/*
+ * Addresses of the MAIN firmware's printf-style loggers. CDJ_FWLOG holds a
+ * comma-separated list; any value that is not a MAIN address (including an
+ * empty CDJ_FWLOG=1) selects the two known ones: 0x084D8674, which every
+ * `@Ui_Browse>` / `@Ui_TaskEvent>` call site jumps to, and 0x08229388, which
+ * carries the storage and `CacheDB DSQLerror!` lines.
+ */
+#define CDJ_FWLOG_MAX 32
+
+/*
+ * A dropped tap is indistinguishable from a cold one, so every list in this
+ * file that caps reports what it dropped.
+ */
+static void cdj_tap_truncated(const char *var, unsigned n, const char *rest)
+{
+    if (rest && *rest) {
+        fprintf(stderr, "%s TRUNCATED at %u entries, dropped: %s\n", var, n, rest);
+    }
+}
+
+static bool cdj_fwlog_hit(uint32_t pc)
+{
+    static uint32_t taps[CDJ_FWLOG_MAX];
+    static unsigned n;
+    static bool resolved;
+    unsigned i;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_FWLOG");
+
+        resolved = true;
+        while (e && *e && n < CDJ_FWLOG_MAX) {
+            const char *start = e;
+            uint32_t a = strtoul(e, (char **)&e, 0);
+
+            if (a >= 0x08000000) {
+                taps[n++] = a;
+            }
+            if (e == start) {   /* unparsable -- stop rather than spin */
+                break;
+            }
+            e += *e == ',';
+        }
+        cdj_tap_truncated("FWLOG", n, e);
+        if (getenv("CDJ_FWLOG") && !n) {
+            taps[n++] = 0x084d8674;
+            taps[n++] = 0x08229388;
+        }
+    }
+
+    for (i = 0; i < n; i++) {
+        if (taps[i] == pc) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * CDJ_FWDUMP=<pc>:<reg>:<off>:<len>[:i] -- see helper_cdj_fwdump(). Parsed once
+ * into the globals the helper reads; 0 means no tap.
+ */
+uint32_t cdj_fwdump_reg, cdj_fwdump_off, cdj_fwdump_len, cdj_fwdump_indirect;
+
+/* CDJ_FWTRACE=<pc>[,<pc>...] -- see helper_cdj_fwtrace(). */
+static bool cdj_fwtrace_hit(uint32_t pc)
+{
+    static uint32_t taps[CDJ_FWLOG_MAX];
+    static unsigned n;
+    static bool resolved;
+    unsigned i;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_FWTRACE");
+
+        resolved = true;
+        while (e && *e && n < CDJ_FWLOG_MAX) {
+            const char *start = e;
+            uint32_t a = strtoul(e, (char **)&e, 0);
+
+            if (a >= 0x08000000) {
+                taps[n++] = a;
+            }
+            if (e == start) {
+                break;
+            }
+            e += *e == ',';
+        }
+        cdj_tap_truncated("FWTRACE", n, e);
+    }
+
+    for (i = 0; i < n; i++) {
+        if (taps[i] == pc) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * CDJ_MWATCH=<addr>[,<addr>...]: watch up to four 32-bit words and print a
+ * line whenever one of them changes, naming the PC of the store that changed
+ * it. A static scan can say whether an addressing form exists in the image,
+ * not what actually wrote a word.
+ *
+ * The tap is emitted only after store instructions (see cdj_is_store), so the
+ * cost is one guest word load per store rather than per instruction. That
+ * matters: the SPI link between the boards is wall-clock paced, so an
+ * instrument that slows MAIN uniformly can starve the link and change the
+ * outcome being measured.
+ *
+ * Read `pc` as where the change was first seen, not who wrote it. The helper
+ * caches the last value of each watched word and prints when the current value
+ * differs, so it names the store it happened to be sampling at. A write by DMA
+ * carries no PC and is attributed to whichever store runs next. Stores in a
+ * delay slot are sampled inside decode_opc(); if pc and pr ever disagree about
+ * which function a write came from, believe pr and look at pr-2 for a store.
+ *
+ * Because the value is compared rather than trapped, a change is never lost:
+ * a "never written" result is sound unless the word was written and restored
+ * within a handful of instructions.
+ */
+#define CDJ_MWATCH_MAX 4
+uint32_t cdj_mwatch_addr[CDJ_MWATCH_MAX];
+unsigned cdj_mwatch_n;
+
+static bool cdj_mwatch_armed(void)
+{
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_MWATCH");
+
+        resolved = true;
+        while (e && *e && cdj_mwatch_n < CDJ_MWATCH_MAX) {
+            const char *start = e;
+            uint32_t a = strtoul(e, (char **)&e, 0);
+
+            if (e == start) {       /* unparsable -- stop rather than spin */
+                break;
+            }
+            cdj_mwatch_addr[cdj_mwatch_n++] = a;
+            e += *e == ',';
+        }
+        cdj_tap_truncated("MWATCH", cdj_mwatch_n, e);
+    }
+    return cdj_mwatch_n != 0;
+}
+
+/*
+ * CDJ_PPOKE=<pc>:<addr>:<or>[:<and>[:<n>[:<wait>]]][,...]: rewrite a word at
+ * an instruction rather than on a timer: *addr = (*addr & and) | or, applied
+ * just before <pc> runs.
+ *
+ * CDJ_MPOKE fires from a QEMU timer, so it can only hold a value that the
+ * guest leaves alone between ticks. When the guest publishes a word and reads
+ * it straight back on the same path, no timer can win the race; anchoring the
+ * write to the reading instruction removes it. It is an experiment, not a fix.
+ *
+ * CDJ_PPOKE_N=<n> limits every spec to its first <n> applications (0 =
+ * unlimited, the default); the optional fifth field overrides it per spec. A
+ * held poke fires on every execution of <pc> and permanently displaces the
+ * state machine it is aimed at; a counted one pushes the machine through a
+ * transition once and then leaves it alone. The sixth field makes the spec
+ * wait for CDJ_PPOKE_ARM.
+ *
+ * Several specs are allowed, so each write can be scoped to its own
+ * instruction instead of holding a word for the whole run.
+ */
+#define CDJ_PPOKE_MAX 8
+
+CdjPpoke cdj_ppoke[CDJ_PPOKE_MAX];
+unsigned cdj_ppoke_n;
+
+/* CDJ_PPOKE_ARM=<pc>: the instruction that makes the waiting pokes live. See
+ * helper_cdj_ppoke_arm(). */
+uint32_t cdj_ppoke_arm_pc_value(void);
+uint32_t cdj_ppoke_arm_pc_value(void)
+{
+    static uint32_t pc;
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_PPOKE_ARM");
+
+        resolved = true;
+        pc = e ? (uint32_t)strtoul(e, NULL, 0) : 0;
+        if (pc) {
+            info_report("ppoke: every poke stays inert until pc 0x%08x runs",
+                        pc);
+        }
+    }
+    return pc;
+}
+
+/*
+ * CDJ_PSTORE=<pc>:<reg>:<addr>[:<n>][,...]: install a pointer the firmware
+ * itself built.
+ *
+ * CDJ_PPOKE asserts a constant; this stores the live value of a register, for
+ * a heap object whose address differs on every run. For example, the firmware
+ * parses the medium's beat grid into an object and hands it out at 0x0826B104
+ * (`mov.l r4,@r13`) in a message nothing installs, so
+ *
+ *     CDJ_PSTORE=0x0826B104:4:0x09950594
+ *
+ * stores that object into the field the time-to-beat mapper reads. Fires
+ * before <pc> executes, as CDJ_PPOKE does, so r4 is already valid there.
+ */
+#define CDJ_PSTORE_MAX 8
+
+CdjPstore cdj_pstore[CDJ_PSTORE_MAX];
+unsigned cdj_pstore_n;
+
+static unsigned cdj_pstore_specs(void)
+{
+    static bool resolved;
+    unsigned i;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_PSTORE");
+
+        resolved = true;
+        while (e && *e && cdj_pstore_n < CDJ_PSTORE_MAX) {
+            CdjPstore *p = &cdj_pstore[cdj_pstore_n];
+
+            p->max = 0;
+            if (sscanf(e, "%i:%i:%i:%u", &p->pc, &p->reg, &p->addr,
+                       &p->max) < 3) {
+                break;
+            }
+            if (p->reg > 15) {
+                warn_report("pstore: r%u is not a register -- spec ignored",
+                            p->reg);
+                break;
+            }
+            cdj_pstore_n++;
+            e = strchr(e, ',');
+            e += e != NULL;
+        }
+        for (i = 0; i < cdj_pstore_n; i++) {
+            info_report("pstore: at pc 0x%08x *0x%08x = r%u%s",
+                        cdj_pstore[i].pc, cdj_pstore[i].addr,
+                        cdj_pstore[i].reg,
+                        cdj_pstore[i].max ? " (counted)" : "");
+        }
+    }
+
+    return cdj_pstore_n;
+}
+
+static unsigned cdj_ppoke_specs(void)
+{
+    static bool resolved;
+    unsigned i;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_PPOKE");
+        const char *n = getenv("CDJ_PPOKE_N");
+        unsigned dflt = n ? strtoul(n, NULL, 0) : 0;
+
+        resolved = true;
+        while (e && *e && cdj_ppoke_n < CDJ_PPOKE_MAX) {
+            CdjPpoke *p = &cdj_ppoke[cdj_ppoke_n];
+
+            p->and = 0xFFFFFFFF;
+            p->max = dflt;
+            p->wait_arm = 0;
+            if (sscanf(e, "%i:%i:%i:%i:%u:%u", &p->pc, &p->addr, &p->or,
+                       &p->and, &p->max, &p->wait_arm) < 3) {
+                break;
+            }
+            cdj_ppoke_n++;
+            e = strchr(e, ',');
+            e += e != NULL;
+        }
+        for (i = 0; i < cdj_ppoke_n; i++) {
+            info_report("ppoke: at pc 0x%08x *0x%08x = (v & 0x%08x) | 0x%08x%s%s",
+                        cdj_ppoke[i].pc, cdj_ppoke[i].addr, cdj_ppoke[i].and,
+                        cdj_ppoke[i].or,
+                        cdj_ppoke[i].max ? " (counted)" : "",
+                        cdj_ppoke[i].wait_arm ? " (waits for the arm)" : "");
+        }
+    }
+
+    return cdj_ppoke_n;
+}
+
+/*
+ * CDJ_PCALL=<pc>:<func>:<r4>:<r5>:<r6>[:<n>]: call a firmware function from
+ * inside a real task context, without a gdbstub.
+ *
+ * Anything the firmware does through get_mpl/snd_mbx has to run in a task.
+ * Borrowing one over the gdbstub halts MAIN for seconds and starves the GUI
+ * link past its timeout. Instead, at <pc> (an address the wanted task
+ * reaches) save the register file, put the arguments in r4/r5/r6, point pr at
+ * a landing pad the firmware never executes, and jump to <func>. When
+ * execution reaches the landing pad the saved state is restored and the guest
+ * resumes at <pc> as if nothing happened.
+ *
+ * Fires <n> times (CDJ_PCALL_N, default 1): a call that repeats turns an
+ * experiment into a different machine.
+ */
+CdjPcall cdj_pcall;
+CdjPcall cdj_pcall2;
+uint32_t cdj_pcall_ret = 0x08000100;   /* never executed by the firmware */
+
+static bool cdj_pcall_armed(void)
+{
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_PCALL");
+        const char *n = getenv("CDJ_PCALL_N");
+        const char *r = getenv("CDJ_PCALL_RET");
+        const char *s = getenv("CDJ_PCALL_SKIP");
+
+        resolved = true;
+        if (r) {
+            cdj_pcall_ret = strtoul(r, NULL, 0);
+        }
+        cdj_pcall.skip = s ? strtoul(s, NULL, 0) : 0;
+        cdj_pcall.max = n ? strtoul(n, NULL, 0) : 1;
+        if (e && sscanf(e, "%i:%i:%i:%i:%i:%u", &cdj_pcall.pc, &cdj_pcall.func,
+                        &cdj_pcall.r4, &cdj_pcall.r5, &cdj_pcall.r6,
+                        &cdj_pcall.max) < 2) {
+            cdj_pcall.pc = 0;
+        }
+        if (cdj_pcall.pc) {
+            info_report("pcall: at pc 0x%08x call 0x%08x(0x%x, 0x%x, 0x%x) "
+                        "x%u after %u skipped, returning to 0x%08x",
+                        cdj_pcall.pc, cdj_pcall.func, cdj_pcall.r4,
+                        cdj_pcall.r5, cdj_pcall.r6, cdj_pcall.max,
+                        cdj_pcall.skip, cdj_pcall_ret);
+        }
+
+        /* Inside the resolve guard: this runs on every translated instruction
+         * otherwise. CDJ_PCALL2 is set whenever Pro DJ Link is on. */
+        const char *e2 = getenv("CDJ_PCALL2");
+
+        if (e2 && sscanf(e2, "%i:%i:%i:%i:%i", &cdj_pcall2.pc, &cdj_pcall2.func,
+                         &cdj_pcall2.r4, &cdj_pcall2.r5, &cdj_pcall2.r6) >= 5) {
+            cdj_pcall2.max = 1;
+            info_report("pcall2: at pc 0x%08x call 0x%08x(0x%x, 0x%x, 0x%x) x1",
+                        cdj_pcall2.pc, cdj_pcall2.func, cdj_pcall2.r4,
+                        cdj_pcall2.r5, cdj_pcall2.r6);
+        }
+    }
+    return cdj_pcall.pc != 0;
+}
+
+/* Every SH-4A encoding that writes memory. Kept deliberately wide: a form left
+ * out does not fail loudly, it just makes the writer invisible.
+ *
+ * Sixteen-bit forms only. The SH-2A 32-bit stores keep their displacement in
+ * a second instruction word, so they are tapped directly in decode_sh2a_32()
+ * via cdj_gen_mwatch_after_store(). Do not add them to this switch: 0x3nm1
+ * collides with the ordinary 0x3 arithmetic group. */
+static bool cdj_is_store(uint16_t op)
+{
+    unsigned lo = op & 0xF, sub = (op >> 8) & 0xF;
+
+    switch (op >> 12) {
+    case 0x0:                       /* mov.X Rm,@(R0,Rn) / movca.l R0,@Rn */
+        return lo == 4 || lo == 5 || lo == 6 || (op & 0xFF) == 0xC3;
+    case 0x1:                       /* mov.l Rm,@(disp,Rn) */
+        return true;
+    case 0x2:                       /* mov.X Rm,@Rn and @-Rn */
+        return lo <= 2 || (lo >= 4 && lo <= 6);
+    case 0x4:                       /* sts.l/stc.l @-Rn, and tas.b @Rn */
+        return lo == 2 || lo == 3 || (op & 0xFF) == 0x1B;
+    case 0x8:                       /* mov.b/mov.w R0,@(disp,Rm) */
+        return sub == 0 || sub == 1;
+    case 0xC:                       /* mov.X R0,@(disp,GBR) */
+        return sub <= 2;
+    case 0xF:                       /* fmov.s FRm,@Rn / @-Rn / @(R0,Rn) */
+        return lo == 3 || lo == 7 || lo == 0xB;
+    default:
+        return false;
+    }
+}
+
+/*
+ * The load forms whose effective address helper_cdj_rwatch() can recompute.
+ * Deliberately the exact mirror of cdj_is_store(): if a form is listed here the
+ * helper must handle it, and if it is not, the helper must never see it.
+ *
+ * PC-relative pool loads (0x9ndd, 0xDndd) are excluded on purpose: they read
+ * the literal pool, never a RAM target, and including them would bury a real
+ * hit under thousands of pool reads.
+ */
+static bool cdj_is_load(uint16_t op)
+{
+    unsigned lo = op & 0xF, sub = (op >> 8) & 0xF;
+
+    switch (op >> 12) {
+    case 0x0:                       /* mov.X @(R0,Rm),Rn */
+        return lo == 0xC || lo == 0xD || lo == 0xE;
+    case 0x4:                       /* lds.l/ldc.l @Rm+ */
+        return lo == 6 || lo == 7;
+    case 0x5:                       /* mov.l @(disp,Rm),Rn */
+        return true;
+    case 0x6:                       /* mov.X @Rm,Rn and @Rm+ */
+        return lo <= 2 || (lo >= 4 && lo <= 6);
+    case 0x8:                       /* mov.b/mov.w @(disp,Rm),R0 */
+        return sub == 4 || sub == 5;
+    case 0xC:                       /* mov.X @(disp,GBR),R0 */
+        return sub >= 4 && sub <= 6;
+    default:
+        return false;
+    }
+}
+
+/* CDJ_RWATCH=<addr>[,<addr>...] -- see helper_cdj_rwatch(). */
+uint32_t cdj_rwatch_addr[CDJ_MWATCH_MAX];
+/*
+ * An optional length per entry, so a watch can cover a whole buffer and
+ * answer "is any of this structure read" in one run:
+ *
+ *   CDJ_RWATCH=0x3C27C000+0x1000,0xFFF88084
+ *
+ * The default length is 4, a single word.
+ */
+uint32_t cdj_rwatch_len[CDJ_MWATCH_MAX];
+unsigned cdj_rwatch_n;
+
+static bool cdj_rwatch_armed(void)
+{
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_RWATCH");
+
+        resolved = true;
+        while (e && *e && cdj_rwatch_n < CDJ_MWATCH_MAX) {
+            const char *start = e;
+            uint32_t a = strtoul(e, (char **)&e, 0);
+
+            if (e == start) {
+                break;
+            }
+            cdj_rwatch_len[cdj_rwatch_n] = 4;
+            if (*e == '+') {
+                uint32_t len = strtoul(e + 1, (char **)&e, 0);
+
+                /* A zero or absent length would silently match nothing; keep
+                 * the word default rather than create a dead entry. */
+                if (len) {
+                    cdj_rwatch_len[cdj_rwatch_n] = len;
+                }
+            }
+            cdj_rwatch_addr[cdj_rwatch_n++] = a;
+            e += *e == ',';
+        }
+        cdj_tap_truncated("RWATCH", cdj_rwatch_n, e);
+    }
+    return cdj_rwatch_n != 0;
+}
+
+/* CDJ_RPOKE=<pc>:<reg>:<value>[,...] -- see helper_cdj_rpoke(). */
+#define CDJ_RPOKE_MAX 4
+uint32_t cdj_rpoke_pc[CDJ_RPOKE_MAX], cdj_rpoke_reg[CDJ_RPOKE_MAX];
+uint32_t cdj_rpoke_val[CDJ_RPOKE_MAX];
+uint32_t cdj_rpoke_step[CDJ_RPOKE_MAX], cdj_rpoke_max[CDJ_RPOKE_MAX];
+unsigned cdj_rpoke_n;
+
+static unsigned cdj_rpoke_specs(void)
+{
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_RPOKE");
+
+        resolved = true;
+        while (e && *e && cdj_rpoke_n < CDJ_RPOKE_MAX) {
+            unsigned n = cdj_rpoke_n;
+
+            cdj_rpoke_step[n] = 0;
+            cdj_rpoke_max[n] = 0;
+            if (sscanf(e, "%i:%i:%i:%i:%i", &cdj_rpoke_pc[n], &cdj_rpoke_reg[n],
+                       &cdj_rpoke_val[n], &cdj_rpoke_step[n],
+                       &cdj_rpoke_max[n]) < 3) {
+                break;
+            }
+            cdj_rpoke_n++;
+            info_report("rpoke: at pc 0x%08x set r%u = 0x%08x step %d wrap %u",
+                        cdj_rpoke_pc[n], cdj_rpoke_reg[n], cdj_rpoke_val[n],
+                        (int)cdj_rpoke_step[n], cdj_rpoke_max[n]);
+            e = strchr(e, ',');
+            e += e != NULL;
+        }
+    }
+    return cdj_rpoke_n;
+}
+
+static uint32_t cdj_fwdump_pc(void)
+{
+    static uint32_t pc;
+    static bool resolved;
+
+    if (unlikely(!resolved)) {
+        const char *e = getenv("CDJ_FWDUMP");
+        char tail[8] = "";
+
+        resolved = true;
+        if (e && sscanf(e, "%i:%u:%i:%u:%7s", &pc, &cdj_fwdump_reg,
+                        &cdj_fwdump_off, &cdj_fwdump_len, tail) >= 4) {
+            cdj_fwdump_indirect = tail[0] == 'i';
+            if (cdj_fwdump_reg > 15) {
+                pc = 0;
+            }
+        }
+    }
+    return pc;
+}
