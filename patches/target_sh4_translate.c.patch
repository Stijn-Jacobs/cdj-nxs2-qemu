+/*
+ * Jump to a dynamic target immediately, with no delay slot -- the SH-2A
+ * RTS/N, RTV/N and JSR/N forms.
+ *
+ * Do not express this as `tcg_gen_mov_i32(cpu_pc, target)` plus DISAS_STOP:
+ * sh4_tr_tb_stop() handles DISAS_STOP with gen_save_cpu_state(ctx, true),
+ * which overwrites cpu_pc with ctx->base.pc_next, so the jump would be
+ * silently dropped and execution would fall through to the next instruction.
+ */
+static void gen_jump_now(DisasContext *ctx, TCGv target)
+{
+    tcg_gen_mov_i32(cpu_pc, target);
+    if (use_exit_tb(ctx)) {
+        tcg_gen_exit_tb(NULL, 0);
+    } else {
+        cdj_gen_exit_kind(ctx, CDJ_EXIT_NOW);
+        tcg_gen_lookup_and_goto_ptr();
+    }
+    ctx->base.is_jmp = DISAS_NORETURN;
+}
