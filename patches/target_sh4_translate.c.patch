+static void sh4_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+{
+    CPUSH4State *env = cpu_env(cs);
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+
+#ifdef CONFIG_USER_ONLY
+    if (unlikely(ctx->envflags & TB_FLAG_GUSA_MASK)
+        && !(ctx->envflags & TB_FLAG_GUSA_EXCLUSIVE)) {
+        /*
+         * We're in an gUSA region, and we have not already fallen
+         * back on using an exclusive region.  Attempt to parse the
+         * region into a single supported atomic operation.  Failure
+         * is handled within the parser by raising an exception to
+         * retry using an exclusive region.
+         *
+         * Parsing the region in one block conflicts with plugins,
+         * so always use exclusive mode if plugins enabled.
+         */
+        if (ctx->base.plugin_enabled) {
+            gen_restart_exclusive(ctx);
+            ctx->base.pc_next += 2;
+        } else {
+            decode_gusa(ctx, env);
+        }
+        return;
+    }
+#endif
+
+    /*
+     * Firmware log tap, see helper_cdj_fwlog(). Placed at translation time so
+     * it costs one comparison per translated instruction and nothing at run
+     * time, unlike a gdbstub breakpoint.
+     */
+    if (unlikely(cdj_fwlog_hit(ctx->base.pc_next))) {
+        gen_helper_cdj_fwlog(tcg_env);
+    }
+    if (unlikely(ctx->base.pc_next == cdj_fwdump_pc())) {
+        gen_helper_cdj_fwdump(tcg_env);
+    }
+    if (unlikely(cdj_fwtrace_hit(ctx->base.pc_next))) {
+        gen_helper_cdj_fwtrace(tcg_env, tcg_constant_i32(ctx->base.pc_next));
+    }
+    /* CDJ_RPOKE: substitute a register for one consumer only. Anchored one
+     * instruction after a load, it changes what that code sees without touching
+     * the memory every other reader shares. */
+    {
+        unsigned i, n = cdj_rpoke_specs();
+
+        for (i = 0; i < n; i++) {
+            if (unlikely(cdj_rpoke_pc[i] == ctx->base.pc_next)) {
+                gen_helper_cdj_rpoke(tcg_env, tcg_constant_i32(i));
+            }
+        }
+    }
+    /* Before the instruction, so a poke anchored to a load is already in memory
+     * when that load reads it. */
+    {
+        unsigned i, n = cdj_ppoke_specs();
+
+        for (i = 0; i < n; i++) {
+            if (unlikely(cdj_ppoke[i].pc == ctx->base.pc_next)) {
+                gen_helper_cdj_ppoke(tcg_env, tcg_constant_i32(i));
+            }
+        }
+        if (unlikely(cdj_ppoke_arm_pc_value() == ctx->base.pc_next)) {
+            gen_helper_cdj_ppoke_arm(tcg_env);
+        }
+    }
+    /* Same placement as the poke: before the instruction, so the register the
+     * firmware is about to store is read while it is still live. */
+    {
+        unsigned i, n = cdj_pstore_specs();
+
+        for (i = 0; i < n; i++) {
+            if (unlikely(cdj_pstore[i].pc == ctx->base.pc_next)) {
+                gen_helper_cdj_pstore(tcg_env, tcg_constant_i32(i));
+            }
+        }
+    }
+
+    /* Both ends of an injected call. The helpers rewrite pc and leave the TB,
+     * so nothing of the tapped instruction runs until the call has returned. */
+    if (unlikely(cdj_pcall_armed())) {
+        if (ctx->base.pc_next == cdj_pcall.pc) {
+            gen_helper_cdj_pcall(tcg_env, tcg_constant_i32(ctx->base.pc_next));
+        }
+    }
+    if (cdj_pcall2.pc && ctx->base.pc_next == cdj_pcall2.pc) {
+        gen_helper_cdj_pcall2(tcg_env, tcg_constant_i32(ctx->base.pc_next));
+    }
+    /* The landing pad is shared, so its hooks are emitted when either call is
+     * armed. Each helper no-ops unless it is the call in flight. */
+    if (ctx->base.pc_next == cdj_pcall_ret
+        && (cdj_pcall_armed() || cdj_pcall2.pc)) {
+        gen_helper_cdj_pcall_ret(tcg_env);
+        gen_helper_cdj_pcall2_ret(tcg_env);
+    }
+
+    if (unlikely(cdj_native_libc(ctx, env))) {
+        return;
+    }
+    cdj_native_copy(ctx, env);
+    /* Emits a conditional halt and falls through: the loop's own instructions
+     * are still translated below, for the iterations the helper lets run. */
+    cdj_gui_idle(ctx, env);
+    if (unlikely(cdj_timed_add(ctx, env))) {
+        return;
+    }
+    ctx->opcode = translator_lduw(env, &ctx->base, ctx->base.pc_next);
+    if ((ctx->features & SH_FEATURE_SH2A) && decode_sh2a_32(ctx, env)) {
+        ctx->base.pc_next += 4;
+        return;
+    }
+
+    decode_opc(ctx);
+    ctx->base.pc_next += 2;
+    cdj_io_split_check(ctx, ctx->base.pc_next - 2);
+}
