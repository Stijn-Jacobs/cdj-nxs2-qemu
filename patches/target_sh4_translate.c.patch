+/*
+ * TB-exit knobs. All default off; each is read once.
+ *
+ * MAIN's vCPU spends a large share of its time in indirect-branch TB lookup.
+ * On SH-4 every call is jsr @Rn and every return rts, so most of that is
+ * structural; these remove the parts that are not, without moving any TB
+ * boundary, so icount charges exactly the same instructions at exactly the
+ * same points:
+ *
+ *   CDJ_JCPROF=1      store why each TB left (CDJ_EXIT_*) for the jump-cache
+ *                     probe in accel/tcg/cpu-exec.c. Measurement only.
+ *   CDJ_TB_FPSCR=1    LDS FPSCR no longer exits to the cpu loop: if PR/SZ/FR
+ *                     are unchanged it chains (goto_tb) to the next insn, else
+ *                     it looks the next TB up in place. The SHC runtime
+ *                     switches PR around calls, so MAIN has many such sites.
+ *   CDJ_TB_XPAGE=1    allow goto_tb across guest pages. QEMU forbids it only
+ *                     because a page's virtual mapping could change under a
+ *                     direct jump; on MAIN MMUCR.AT is never set (the board's
+ *                     CCN model does not even pass MMUCR to env) and SDRAM is
+ *                     a fixed region, so it cannot. Guarded to SH-4, MMU off,
+ *                     and both ends in SDRAM (phys 0x08000000-0x17FFFFFF).
+ *   CDJ_TB_CALLPRED=1 for jsr/jmp @Rn whose Rn came from a literal load in the
+ *                     same TB, compare the runtime target with the literal and
+ *                     chain directly when equal; otherwise look up as before.
+ *                     Exact by construction: the literal is only a guess.
+ *                     Needs CDJ_TB_XPAGE for targets on another page.
+ */
+static bool cdj_tb_knob(const char *name, int *cache)
+{
+    if (unlikely(*cache < 0)) {
+        const char *e = getenv(name);
+
+        *cache = e && *e && strcmp(e, "0") != 0;
+        if (*cache) {
+            info_report("sh4 translate: %s on", name);
+        }
+    }
+    return *cache;
+}
+
+static int cdj_knob_jcprof = -1, cdj_knob_fpscr = -1, cdj_knob_xpage = -1,
+           cdj_knob_callpred = -1;
+#define CDJ_TB_JCPROF()   cdj_tb_knob("CDJ_JCPROF", &cdj_knob_jcprof)
+#define CDJ_TB_FPSCR()    cdj_tb_knob("CDJ_TB_FPSCR", &cdj_knob_fpscr)
+#define CDJ_TB_XPAGE()    cdj_tb_knob("CDJ_TB_XPAGE", &cdj_knob_xpage)
+#define CDJ_TB_CALLPRED() cdj_tb_knob("CDJ_TB_CALLPRED", &cdj_knob_callpred)
+
+/*
+ * CDJ_IOPROF / CDJ_IOSPLIT: mid-TB MMIO rewinds.
+ *
+ * QEMU 9.1 clears can_do_io before the first instruction of every multi-insn
+ * TB and sets it before the last one, icount or not (translator.c). An MMIO
+ * access from any other position rewinds the TB on every execution:
+ * cpu_io_recompile() searches the host-pc -> TB tree (tb_tc_cmp), restores
+ * state, longjmps out of the TB, and runs a one-instruction TB. MAIN does this
+ * in its GPIO read-modify-writes (0xA405016x), the interrupt entry's INTEVT
+ * read (0xFF000028) and TMU/INTC polls.
+ *
+ *   CDJ_IOPROF=1   count the rewinds per guest pc and print the top sites
+ *                  every 2^16 rewinds. Read-only.
+ *   CDJ_IOSPLIT=1  on the first rewind at a pc, remember it and invalidate the
+ *                  TBs holding it; the translator then ends a TB just before
+ *                  that instruction and just after it. Those are exactly the
+ *                  boundaries the rewind produces at run time (prefix, the I/O
+ *                  instruction alone, the rest), so the guest meets the same
+ *                  interrupt check points and the same icount charge, and the
+ *                  I/O instruction runs with can_do_io set; only the rewind
+ *                  is gone. SH-4 only; never splits a branch from its slot.
+ *
+ * Called once per cpu_io_recompile() from the io_recompile_replay_branch hook
+ * (cpu.c), after that hook has moved env->pc back to a delay slot's branch.
+ */
+#define CDJ_IO_SLOTS 4096              /* power of two */
+#define CDJ_IO_MAXFILL (CDJ_IO_SLOTS * 3 / 4)
+
+typedef struct CdjIoSite {
+    uint32_t pc;                       /* 0 = empty slot */
+    bool split;
+    uint64_t count;
+} CdjIoSite;
+
+static CdjIoSite cdj_io_site[CDJ_IO_SLOTS];
+static unsigned cdj_io_used, cdj_io_nsplit;
+static uint64_t cdj_io_total;
+static int cdj_knob_ioprof = -1, cdj_knob_iosplit = -1;
+
+static CdjIoSite *cdj_io_find(uint32_t pc, bool insert)
+{
+    unsigned i = ((pc >> 1) * 0x9E3779B1u) >> (32 - 12);
+    unsigned probes;
+
+    for (probes = 0; probes < CDJ_IO_SLOTS; probes++) {
+        CdjIoSite *s = &cdj_io_site[(i + probes) & (CDJ_IO_SLOTS - 1)];
+
+        if (s->pc == pc) {
+            return s;
+        }
+        if (s->pc == 0) {
+            if (!insert || cdj_io_used >= CDJ_IO_MAXFILL) {
+                return NULL;
+            }
+            cdj_io_used++;
+            s->pc = pc;
+            return s;
+        }
+    }
+    return NULL;
+}
+
+static void cdj_io_print(void)
+{
+    CdjIoSite *top[12] = { NULL };
+    unsigned i, j;
+
+    for (i = 0; i < CDJ_IO_SLOTS; i++) {
+        CdjIoSite *s = &cdj_io_site[i];
+
+        for (j = 0; s->pc && j < ARRAY_SIZE(top); j++) {
+            if (!top[j] || s->count > top[j]->count) {
+                memmove(&top[j + 1], &top[j],
+                        (ARRAY_SIZE(top) - j - 1) * sizeof(top[0]));
+                top[j] = s;
+                break;
+            }
+        }
+    }
+    fprintf(stderr, "[CDJ] ioprof total=%" PRIu64 " sites=%u split=%u top:",
+            cdj_io_total, cdj_io_used, cdj_io_nsplit);
+    for (j = 0; j < ARRAY_SIZE(top) && top[j]; j++) {
+        fprintf(stderr, " %08x=%" PRIu64, top[j]->pc, top[j]->count);
+    }
+    fprintf(stderr, "\n");
+}
+
+void cdj_io_recompiled(CPUSH4State *env)
+{
+    bool prof = cdj_tb_knob("CDJ_IOPROF", &cdj_knob_ioprof);
+    bool split = cdj_tb_knob("CDJ_IOSPLIT", &cdj_knob_iosplit)
+                 && !(env->features & SH_FEATURE_SH2A);
+    CdjIoSite *s;
+
+    if (likely(!prof && !split)) {
+        return;
+    }
+    s = cdj_io_find(env->pc, true);
+    cdj_io_total++;
+    if (s) {
+        s->count++;
+    }
+    if (prof && (cdj_io_total & 0xFFFF) == 0) {
+        cdj_io_print();
+    }
+    if (split && s && !s->split) {
+        tb_page_addr_t phys = get_page_addr_code(env, env->pc);
+
+        s->split = true;
+        cdj_io_nsplit++;
+        if (phys != -1) {
+            /* Includes the TB being rewound; cpu_io_recompile() never returns
+             * into it, so that is safe. */
+            tb_invalidate_phys_range(phys, phys + 1);
+        }
+    }
+}
+
+static bool cdj_io_is_split(uint32_t pc)
+{
+    CdjIoSite *s = cdj_io_find(pc, false);
+
+    return s && s->split;
+}
+
+/* End the TB around a learned I/O instruction; see cdj_io_recompiled(). */
+static void cdj_io_split_check(DisasContext *ctx, uint32_t insn_pc)
+{
+    if (likely(!cdj_io_nsplit) || ctx->base.is_jmp != DISAS_NEXT
+        || (ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)) {
+        return;
+    }
+    if (cdj_io_is_split(insn_pc) || cdj_io_is_split(ctx->base.pc_next)) {
+        ctx->base.is_jmp = DISAS_TOO_MANY;
+    }
+}
+
+static void cdj_gen_exit_kind(DisasContext *ctx, unsigned kind)
+{
+    if (unlikely(CDJ_TB_JCPROF())) {
+        tcg_gen_st_i32(tcg_constant_i32(kind), tcg_env,
+                       offsetof(CPUSH4State, cdj_exit_kind));
+    }
+}
+
+static bool cdj_in_sdram(uint32_t vaddr)
+{
+    uint32_t phys = vaddr & 0x1fffffff;
+
+    return vaddr < 0xc0000000 && phys >= 0x08000000 && phys < 0x18000000;
+}
+
 static inline bool use_exit_tb(DisasContext *ctx)
 {
     return (ctx->tbflags & TB_FLAG_GUSA_EXCLUSIVE) != 0;
 }
 
+/*
+ * How an LDS FPSCR ends its TB. The TB still ends right after it (so nothing
+ * changes for icount); CDJ_TB_FPSCR only changes where it goes next. Not in a
+ * delay slot (the branch there ends the TB) and not in a gUSA region.
+ */
+static int cdj_fpscr_stop(DisasContext *ctx)
+{
+    if (CDJ_TB_FPSCR() && !(ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)
+        && !use_exit_tb(ctx)) {
+        return DISAS_CDJ_FPSCR;
+    }
+    return DISAS_STOP;
+}
+
 static bool use_goto_tb(DisasContext *ctx, target_ulong dest)
 {
     if (use_exit_tb(ctx)) {
         return false;
     }
+    if (ctx->cdj_xpage_ok && cdj_in_sdram(dest)) {
+        return !(tb_cflags(ctx->base.tb) & CF_NO_GOTO_TB);
+    }
     return translator_use_goto_tb(&ctx->base, dest);
 }
 
