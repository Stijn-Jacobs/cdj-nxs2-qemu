+/*
+ * CDJ_NATIVE_LIBC=1: run the MAIN firmware's memcmp and strlen as host code;
+ * see helper_cdj_memcmp(). Each entry is recognised by its address AND its
+ * first opcode, so another image (the GUI, a different firmware build) can
+ * never be hooked by accident.
+ */
+#define CDJ_MEMCMP_PC 0x085336B0u   /* tst r6,r6 */
+#define CDJ_STRLEN_PC 0x085341C0u   /* bra +1    */
+
+static bool cdj_native_libc_on(void)
+{
+    static int on = -1;
+
+    if (unlikely(on < 0)) {
+        const char *e = getenv("CDJ_NATIVE_LIBC");
+
+        on = e && *e && strcmp(e, "0") != 0;
+        if (on) {
+            info_report("native libc: memcmp 0x%08x, strlen 0x%08x run as host code",
+                        CDJ_MEMCMP_PC, CDJ_STRLEN_PC);
+        }
+    }
+    return on;
+}
+
+static bool cdj_native_libc(DisasContext *ctx, CPUSH4State *env)
+{
+    uint32_t pc = ctx->base.pc_next;
+    uint16_t op;
+
+    if (likely(pc != CDJ_MEMCMP_PC && pc != CDJ_STRLEN_PC)
+        || (ctx->features & SH_FEATURE_SH2A)
+        || (ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)
+        || !cdj_native_libc_on()) {
+        return false;
+    }
+    op = translator_lduw(env, &ctx->base, pc);
+    if (pc == CDJ_MEMCMP_PC && op == 0x2668) {
+        translator_io_start(&ctx->base);
+        gen_helper_cdj_memcmp(REG(0), tcg_env, REG(4), REG(5), REG(6));
+    } else if (pc == CDJ_STRLEN_PC && op == 0xa001) {
+        translator_io_start(&ctx->base);
+        gen_helper_cdj_strlen(REG(0), tcg_env, REG(4));
+    } else {
+        return false;
+    }
+    ctx->base.pc_next += 2;
+    gen_jump_now(ctx, cpu_pr);
+    return true;
+}
+
+/*
+ * CDJ_NATIVE_COPY=1 (default off): MAIN's memcpy, memset and the compiler's
+ * block-copy helper as host code; see helper_cdj_native_copy().
+ * Same recognition as above (address AND first opcode). The helper may decline
+ * (MMIO, a fault, an overlap the guest would not handle like memmove), so this
+ * emits a conditional return through PR and then lets the entry instruction be
+ * translated as usual: when the helper says no, the guest routine simply runs.
+ */
+#define CDJ_MEMCPY_PC 0x085336DCu   /* mov #0x18,r2     */
+#define CDJ_MEMSET_PC 0x08533D50u   /* mov.l r14,@-r15  */
+#define CDJ_MOVMEM_PC 0x08531F88u   /* mov.l r3,@-r15   */
+
+static bool cdj_native_copy_on(void)
+{
+    static int on = -1;
+
+    if (unlikely(on < 0)) {
+        const char *e = getenv("CDJ_NATIVE_COPY");
+
+        on = e && *e && strcmp(e, "0") != 0;
+        if (on) {
+            info_report("native copy: memcpy 0x%08x, memset 0x%08x, block copy "
+                        "0x%08x run as host code", CDJ_MEMCPY_PC,
+                        CDJ_MEMSET_PC, CDJ_MOVMEM_PC);
+        }
+    }
+    return on;
+}
+
+static void cdj_native_copy(DisasContext *ctx, CPUSH4State *env)
+{
+    uint32_t pc = ctx->base.pc_next;
+    uint16_t want;
+    TCGLabel *guest;
+    TCGv_i32 done;
+
+    switch (pc) {
+    case CDJ_MEMCPY_PC:
+        want = 0xe218;
+        break;
+    case CDJ_MEMSET_PC:
+        want = 0x2fe6;
+        break;
+    case CDJ_MOVMEM_PC:
+        want = 0x2f36;
+        break;
+    default:
+        return;
+    }
+    if ((ctx->features & SH_FEATURE_SH2A)
+        || (ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)
+        || !cdj_native_copy_on()
+        || translator_lduw(env, &ctx->base, pc) != want) {
+        return;
+    }
+    translator_io_start(&ctx->base);
+    done = tcg_temp_new_i32();
+    guest = gen_new_label();
+    gen_helper_cdj_native_copy(done, tcg_env, tcg_constant_i32(pc));
+    tcg_gen_brcondi_i32(TCG_COND_EQ, done, 0, guest);
+    tcg_gen_mov_i32(cpu_pc, cpu_pr);
+    if (use_exit_tb(ctx)) {
+        tcg_gen_exit_tb(NULL, 0);
+    } else {
+        tcg_gen_lookup_and_goto_ptr();
+    }
+    gen_set_label(guest);
+}
+
+/*
+ * CDJ_GUI_IDLE_PC=<hex>: run the display board's idle loop as a halt.
+ *
+ * Only the loop head is hooked, and only when the instruction there is the
+ * expected `mov.l @r1,r2` (0x6212), as with the native-libc hook above, so a
+ * stale address from another image is never hooked by accident. Unset by
+ * default: this changes when the guest's CPU runs.
+ */
+static uint32_t cdj_gui_idle_pc(void)
+{
+    static uint32_t pc = 1;             /* 1 = not looked up yet (never a PC) */
+
+    if (unlikely(pc == 1)) {
+        const char *e = getenv("CDJ_GUI_IDLE_PC");
+
+        pc = (e && *e) ? (uint32_t)strtoul(e, NULL, 0) : 0;
+        if (pc) {
+            info_report("gui idle: 0x%08x executed as a halt", pc);
+        }
+    }
+    return pc;
+}
+
+static bool cdj_gui_idle(DisasContext *ctx, CPUSH4State *env)
+{
+    uint32_t pc = ctx->base.pc_next;
+
+    if (likely(pc != cdj_gui_idle_pc())
+        || (ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)
+        || translator_lduw(env, &ctx->base, pc) != 0x6212) {
+        return false;
+    }
+    /*
+     * Resume on the loop head itself: the helper either halts (and the CPU
+     * comes back here when an interrupt arrives) or returns, in which case the
+     * instruction is translated normally below and the loop runs as it always
+     * did. Either way this is where execution belongs.
+     */
+    tcg_gen_movi_i32(cpu_pc, pc);
+    translator_io_start(&ctx->base);
+    gen_helper_cdj_gui_idle(tcg_env);
+    return true;
+}
+
+/*
+ * CDJ_TIMED_ADD=<pc>:<ms>: the `add #imm,Rn` at <pc> adds imm per <ms> of
+ * virtual time instead of imm per execution; see helper_cdj_timed_add(). For
+ * firmware animations that step once per frame, when the frame rate has been
+ * changed. Only an `add #imm` outside a delay slot is hooked.
+ */
+static unsigned cdj_timed_add_ms;
+
+static uint32_t cdj_timed_add_pc(void)
+{
+    static uint32_t pc = 1;             /* 1 = not looked up yet (never a PC) */
+
+    if (unlikely(pc == 1)) {
+        const char *e = getenv("CDJ_TIMED_ADD");
+        unsigned ms = 0;
+
+        pc = 0;
+        if (e && sscanf(e, "%i:%u", (int *)&pc, &ms) == 2 && ms) {
+            cdj_timed_add_ms = ms;
+            info_report("timed add: 0x%08x steps per %u ms, not per run",
+                        pc, ms);
+        } else {
+            pc = 0;
+        }
+    }
+    return pc;
+}
+
+static bool cdj_timed_add(DisasContext *ctx, CPUSH4State *env)
+{
+    uint32_t pc = ctx->base.pc_next;
+    uint16_t op;
+
+    if (likely(pc != cdj_timed_add_pc())
+        || (ctx->envflags & TB_FLAG_DELAY_SLOT_MASK)) {
+        return false;
+    }
+    op = translator_lduw(env, &ctx->base, pc);
+    if ((op & 0xf000) != 0x7000) {
+        return false;
+    }
+    translator_io_start(&ctx->base);
+    gen_helper_cdj_timed_add(REG((op >> 8) & 0xf), tcg_env,
+                             REG((op >> 8) & 0xf),
+                             tcg_constant_i32((int8_t)op),
+                             tcg_constant_i32(cdj_timed_add_ms));
+    ctx->base.pc_next += 2;
+    return true;
+}
