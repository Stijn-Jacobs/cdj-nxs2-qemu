# The Pioneer CDJ boards. scripts/install_machine.sh copies this tree to
# qemu-src/hw/sh4/cdj/; hw/sh4/meson.build only says subdir('cdj').
#
#   common/          what every board shares (boot, SH-4 core blocks, env
#                    cache, the host panel-key channel)
#   boards/<model>/  one machine each, with its SoC and device models
#   c6x/             the TI C66x DSP core library
#
# New board source files are added in their board's meson.build, not in a patch.

# Board sources include the shared headers by name ("cdj_common.h",
# "cdj_getenv.h", "c6x/c66x.h") from wherever they sit in the tree.
sh4_ss.add(declare_dependency(include_directories: include_directories('.', 'common')))

# The C66x DSP library, generated by install_machine.sh since its paths are
# host-specific. It defines cdjc6x and adds it to sh4_ss.
subdir('c6x')
subdir('common')
subdir('boards/nxs2')
subdir('boards/cdj2000')
